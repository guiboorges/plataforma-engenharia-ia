{
  "name": "plataforma-engenharia-ia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-course.mjs",
    "predev": "node scripts/sync-course.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/sync-course.mjs && tsc --noEmit && vite build && node scripts/build-artifact.mjs",
    "build:pages": "tsc --noEmit && vite build && node scripts/build-pages.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "19.3.0",
    "typescript": "5.6.3",
    "vite": "6.4.1"
  }
}
